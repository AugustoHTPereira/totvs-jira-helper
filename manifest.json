{
    "manifest_version": 3,
    "name": "TOTVS Jira Helper",
    "version": "4.0.0",
    "description": "Adiciona facilitador de formatação para Code Reviews e Pull Requests no Jira da TOTVS",
    "permissions": [
        "scripting",
        "activeTab"
    ],
    "content_scripts": [
    {
      "matches": ["https://jiraproducao.totvs.com.br/browse/*"],
      "js": ["content.js"],
      "css": ["assets/style.css"]
    }
  ]
}